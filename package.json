{
  "name": "crowbear",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @crowbear/sandbox dev",
    "check": "biome check . && pnpm -r typecheck",
    "format": "biome check --write .",
    "test": "vitest run",
    "build": "pnpm -r build && node scripts/assemble.mjs",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
